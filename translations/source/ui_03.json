 {
  "id": "u805",
  "context": "caruspex::ThrottlePage",
  "de": "Vorher prüfen",
  "en": "Check beforehand",
  "plural": false
 },
 {
  "id": "u806",
  "context": "caruspex::ThrottlePage",
  "de": "Damit das Anlernen sauber durchläuft, müssen diese Punkte stimmen:\n  - Motor betriebswarm, mindestens 80 Grad Kühlmitteltemperatur\n  - Alle Verbraucher aus: Licht, Gebläse, Klima, Heckscheibe\n  - Lenkrad geradeaus, Getriebe in Leerlauf, Handbremse angezogen\n  - Gaspedal nicht antippen, während die Grundeinstellung läuft\n  - Fehlerspeicher vorher löschen, sonst bricht das Steuergerät ab",
  "en": "For the adaptation to run cleanly, these conditions must be met:\n  - Engine at operating temperature, coolant at least 80 degrees\n  - All consumers off: lights, blower, air conditioning, rear window heater\n  - Steering wheel straight, transmission in neutral, handbrake applied\n  - Do not touch the accelerator pedal while basic settings are running\n  - Clear the fault memory first, otherwise the control unit aborts",
  "plural": false
 },
 {
  "id": "u807",
  "context": "caruspex::ThrottlePage",
  "de": "Grundeinstellung starten",
  "en": "Start basic settings",
  "plural": false
 },
 {
  "id": "u808",
  "context": "caruspex::ThrottlePage",
  "de": "Messwertblock 060 (Saugrohreinspritzung, z.B. 1.4 MPI)",
  "en": "Measuring block 060 (port fuel injection, e.g. 1.4 MPI)",
  "plural": false
 },
 {
  "id": "u809",
  "context": "caruspex::ThrottlePage",
  "de": "Messwertblock 098 (Direkteinspritzung, z.B. 1.6 FSI)",
  "en": "Measuring block 098 (direct injection, e.g. 1.6 FSI)",
  "plural": false
 },
