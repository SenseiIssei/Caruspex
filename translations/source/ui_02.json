  "id": "u666",
  "context": "caruspex::ScanPage",
  "de": "Alle Steuergeräte durchsuchen",
  "en": "Scan All Control Units",
  "plural": false
 },
 {
  "id": "u667",
  "context": "caruspex::ScanPage",
  "de": "Klappert der Reihe nach jedes bekannte Steuergerät ab und zeigt, welche das Fahrzeug hat und wo etwas im Speicher steht. Jeder Versuch braucht wegen der 5-Baud-Weckadresse ein paar Sekunden, der ganze Durchlauf also rund eine Minute. Dafür wird ein KKL-Kabel gebraucht, ein ELM327 kommt an die Steuergeräte außerhalb des Motors nicht heran.",
  "en": "Queries every known control unit in turn and shows which ones the vehicle has and where something is stored in fault memory. Each attempt takes a few seconds because of the 5-baud wake-up address, so a full run takes about a minute. This requires a KKL cable; an ELM327 cannot reach control units other than the engine.",
  "plural": false
 },
 {
  "id": "u668",
  "context": "caruspex::ScanPage",
  "de": "Suchen",
  "en": "Search",
  "plural": false
 },
