 },
 {
  "id": "u706",
  "context": "caruspex::SettingsPage",
  "de": "Alles wird sofort übernommen und beim nächsten Start wieder so geladen. Änderungen wirken auch während einer laufenden Messung.",
  "en": "Everything is applied immediately and loaded the same way on the next start. Changes also take effect during a running measurement.",
