{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Caruspex",
  "version": "0.9.0",
  "identifier": "dev.senseiissei.caruspex",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5287",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Caruspex - Fahrzeugdiagnose",
        "width": 1440,
        "height": 920,
        "minWidth": 980,
        "minHeight": 640,
        "decorations": false,
        "shadow": true,
        "resizable": true,
        "center": true,
        "backgroundColor": "#0a0c11"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; frame-src 'self' blob: data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Free car diagnostics",
    "copyright": "SenseiIssei, MIT licence",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
