{
  "name": "caruspex-app",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "i18n": "node scripts/gen-i18n.mjs",
    "fonts": "node scripts/copy-fonts.mjs",
    "prepare-assets": "node scripts/gen-i18n.mjs && node scripts/copy-fonts.mjs",
    "dev": "npm run prepare-assets && vite",
    "build": "npm run prepare-assets && tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:app": "tauri dev -- --no-default-features"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
